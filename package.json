{
  "name": "recruitment-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "start:server": "node server/index.js",
    "server:install": "cd server && npm install",
    "pkg": "cd server && npm run build:exe",
    "pkg:check": "cd server && npm list pkg || npm install pkg --save-dev",
    "release": "npm run build && npm run pkg"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.6.3",
    "@vue-office/pdf": "^1.6.3",
    "axios": "^1.6.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.6.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-demi": "^0.14.10",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0"
  }
}
